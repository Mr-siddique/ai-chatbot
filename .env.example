# Used by `docker compose up`. Copy to .env and fill in.
# MONGODB_URI defaults to the bundled mongo container; set an Atlas URI here to use Atlas instead.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-support

NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:8080

OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
AI_TIMEOUT_MS=30000
AI_CONTEXT_MESSAGES=10

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_MAX=10
