# Used by `docker compose up`. Copy to .env and fill in.
# MONGODB_URI defaults to the bundled mongo container; set an Atlas URI here to use Atlas instead.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-support

NODE_ENV=production
# Optional: fatal|error|warn|info|debug|trace|silent (default: info in production)
# LOG_LEVEL=info
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Session length: a number with unit s, m, h, d or w (e.g. 12h, 7d)
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:8080
# docker compose serves plain http on :8080, so the Secure cookie flag is off there by default.
# Set COOKIE_SECURE=true when the app is behind https.
# COOKIE_SECURE=false

OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
AI_TIMEOUT_MS=30000
AI_CONTEXT_MESSAGES=10

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_MAX=10
