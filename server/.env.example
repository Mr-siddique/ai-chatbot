# --- Runtime ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Local: mongodb://localhost:27017/ai-support
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-support?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ai-support

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Session length: a number with unit s, m, h, d or w (e.g. 12h, 7d)
JWT_EXPIRES_IN=7d

# --- CORS (comma-separated). Only needed if the client is NOT behind the /api proxy ---
CLIENT_ORIGIN=http://localhost:5173

# --- AI (OpenRouter) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
AI_TIMEOUT_MS=30000
AI_CONTEXT_MESSAGES=10

# --- Rate limiting (bonus) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_MAX=10
